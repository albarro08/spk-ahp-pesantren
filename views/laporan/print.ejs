<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Laporan SPK AHP</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    body{
      background:#f5f7fb;
      font-family:'Poppins',sans-serif;
      color:#1f2937;
    }

    .report-container{
      max-width:1100px;
      margin:40px auto;
      background:white;
      border-radius:24px;
      overflow:hidden;
      box-shadow:0 10px 40px rgba(0,0,0,0.08);
    }

    .report-header{
      background:linear-gradient(135deg,#065f46,#10b981);
      padding:40px;
      color:white;
    }

    .logo{
      width:80px;
      height:80px;
      background:white;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }

    .logo img{
      width:60px;
    }

    .title{
      font-size:30px;
      font-weight:700;
      margin-bottom:5px;
    }

    .subtitle{
      opacity:0.9;
    }

    .section-card{
      background:white;
      border-radius:20px;
      padding:25px;
      box-shadow:0 4px 20px rgba(0,0,0,0.05);
      margin-bottom:25px;
    }

    .info-card{
      border-radius:20px;
      padding:25px;
      color:white;
    }

    .bg-emerald{
      background:linear-gradient(135deg,#059669,#34d399);
    }

    .bg-blue{
      background:linear-gradient(135deg,#2563eb,#60a5fa);
    }

    .bg-dark{
      background:linear-gradient(135deg,#111827,#374151);
    }

    .table thead{
      background:#ecfdf5;
    }

    .badge-status{
      padding:10px 18px;
      border-radius:999px;
      font-size:14px;
    }

    .footer{
      text-align:center;
      color:#6b7280;
      padding:30px;
      font-size:14px;
    }

    .print-btn{
      border:none;
      padding:12px 24px;
      border-radius:14px;
      font-weight:600;
    }

    @media print{

      .no-print{
        display:none;
      }

      body{
        background:white;
      }

      .report-container{
        box-shadow:none;
        margin:0;
      }

    }

  </style>

</head>

<body>

<div class="container py-4 no-print">

  <div class="d-flex justify-content-between">

    <a href="/dashboard" class="btn btn-secondary rounded-4 px-4">
      ← Kembali
    </a>

    <button onclick="window.print()" class="btn btn-success rounded-4 px-4">
      Print PDF
    </button>

  </div>

</div>

<div class="report-container">

  <!-- HEADER -->

  <div class="report-header">

    <div class="d-flex align-items-center gap-4">

      <div class="logo">

        <img src="/img/logo.png" alt="Logo">

      </div>

      <div>

        <div class="title">
          Pondok Pesantren Al Asy'ariyah
        </div>

        <div class="subtitle">
          Sistem Pendukung Keputusan Penentuan Prioritas Komponen Biaya Awal Masuk Santri Baru Menggunakan Metode AHP
        </div>

      </div>

    </div>

  </div>

  <div class="p-4">

    <!-- INFO -->

    <div class="row g-4 mb-4">

      <div class="col-md-4">

        <div class="info-card bg-emerald">

          <h6>Nilai CI</h6>

          <h2>
            <%= Number(hasil.ci).toFixed(4) %>
          </h2>

        </div>

      </div>

      <div class="col-md-4">

        <div class="info-card bg-blue">

          <h6>Nilai CR</h6>

          <h2>
            <%= Number(hasil.cr).toFixed(4) %>
          </h2>

        </div>

      </div>

      <div class="col-md-4">

        <div class="info-card bg-dark">

          <h6>Status Konsistensi</h6>

          <h2>
            <%= hasil.status %>
          </h2>

        </div>

      </div>

    </div>

    <!-- RANKING -->

    <div class="section-card">

      <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">
          Ranking Prioritas Kriteria
        </h4>

        <span class="badge bg-success badge-status">

          <%= hasil.status %>

        </span>

      </div>

      <div class="table-responsive">

        <table class="table align-middle">

          <thead>

            <tr>

              <th>Ranking</th>
              <th>Kriteria</th>
              <th>Bobot</th>
              <th>Persentase</th>

            </tr>

          </thead>

          <tbody>

            <% for(let i = 0; i < hasil.ranking.length; i++) { %>

              <tr>

                <td>

                  <strong>
                    #<%= i + 1 %>
                  </strong>

                </td>

                <td>

                  <%= hasil.ranking[i].nama %>

                </td>

                <td>

                  <%= Number(hasil.ranking[i].bobot).toFixed(4) %>

                </td>

                <td width="40%">

                  <div class="progress" style="height:22px;">

                    <div class="progress-bar bg-success"style="width:<%= hasil.ranking[i].bobot * 100 %>%">

                      <%= (hasil.ranking[i].bobot * 100).toFixed(1) %>%

                    </div>

                  </div>

                </td>

              </tr>

            <% } %>

          </tbody>

        </table>

      </div>

    </div>

    <!-- TANDA TANGAN -->

    <div class="row mt-5">

      <div class="col-6">

        <p class="text-muted">
          Dicetak pada:
          <%= new Date().toLocaleDateString('id-ID') %>
        </p>

      </div>

      <div class="col-6 text-end">

        <p>
          Mengetahui,
        </p>

        <br><br><br>

        <strong>
          Bara Alim Fauzi
        </strong>

      </div>

    </div>

  </div>

  <div class="footer">

    © <%= new Date().getFullYear() %>
    Pondok Pesantren Al Asy'ariyah

  </div>

</div>

</body>

</html>